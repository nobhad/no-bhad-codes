<footer class="footer">
      <!-- Black curtain. Sits below the viewport edge until the active page's
           scroll container reaches its end; FooterCurtainModule drives the
           reveal with GSAP, scrubbed against the last stretch of scroll. -->
      <div class="footer-curtain" data-footer-curtain aria-hidden="true">
        <div class="footer-curtain__inner" data-footer-curtain-inner>
          <div class="footer-curtain__mark">
            <!-- Both of these sit beside the link, never inside it. Inside the
                 <a> they would join its visible label while the aria-label
                 stayed "No Bhad Codes home" — a WCAG 2.5.3 mismatch — and
                 neither would be announced at all, since aria-label replaces
                 the content it wraps. Neither is a link to the homepage. -->
            <p class="footer-curtain__credit">Made &amp; Designed by</p>
            <a class="footer-curtain__brand" href="/" aria-label="No Bhad Codes home">
              <img
                class="footer-curtain__avatar"
                src="/images/avatar.svg"
                alt=""
                width="288"
                height="356"
                loading="lazy"
                decoding="async"
              />
              <p class="footer-curtain__wordmark">no bhad codes</p>
            </a>
            <p class="footer-curtain__year">&copy; <span class="js-copyright-year"></span></p>
          </div>

        </div>
      </div>
    </footer>
